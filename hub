Hub.GoToSelectedBrainrotRetry = function(duration, forcedPetData, onDone)
    if not Hub.GoToSelectedBrainrot then return false end
    Hub.GoToBrainrotRetryToken = (Hub.GoToBrainrotRetryToken or 0) + 1
    local retryToken = Hub.GoToBrainrotRetryToken
    Hub.GoToBrainrotMoveToken = retryToken
    task.spawn(function()
        local started = tick()
        local success = false
        Hub.PendingGoToBrainrotData = forcedPetData or Hub.PendingGoToBrainrotData
        repeat
            if retryToken ~= Hub.GoToBrainrotRetryToken then break end
            local ok, result = pcall(Hub.GoToSelectedBrainrot)
            if ok and result then
                success = true
                break
            end
            if not ok then
                Hub.PATHFINDING_ACTIVE = false
                pcall(setNoAnimation, false)
            end
            task.wait(0.12)
        until tick() - started > (duration or 10)
        if retryToken == Hub.GoToBrainrotRetryToken then
            Hub.PendingGoToBrainrotData = nil
            Hub.GoToBrainrotMoveToken = nil
        end
        if onDone then pcall(onDone, success, retryToken == Hub.GoToBrainrotRetryToken) end
    end)
    return true
end

