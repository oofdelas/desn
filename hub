local function ensureGrapplerTP()
    if type(_G.VanishStartSideTP) == "function" and not Hub.GrapplerTP.NeedsReload then
        Hub.GrapplerTP.Loaded = true
        return true
    end
    if Hub.GrapplerTP.Loading then return false end
    if not loadstring then
        ShowNotification("Grappler TP", "loadstring unavailable")
        return false
    end

    Hub.GrapplerTP.Loading = true
    local ok, err = pcall(function()
        _G.VanishEmbeddedMode = true
        local grapplerSpeed = math.floor(Config.TpSettings.GrapplerSpeed or 200)
        local grapplerFinalSpeed = math.floor(Config.TpSettings.GrapplerFinalVelocity or 90)
        local grapplerTimeoutSpeed = math.max(1, math.floor(grapplerSpeed * 0.5))
        local source = Hub.GrapplerTP.Source
        source = source:gsub("local CARPET_SPEED = 400", "local CARPET_SPEED = " .. tostring(grapplerSpeed), 1)
        source = source:gsub("local INBASE_SPEED = 180", "local INBASE_SPEED = " .. tostring(grapplerFinalSpeed), 1)
        source = source:gsub("local SPEED = 200", "local SPEED = " .. tostring(grapplerTimeoutSpeed), 1)
        local fn, loadErr = loadstring(source)
        if not fn then error(loadErr or "load failed") end
        fn()
    end)
    Hub.GrapplerTP.Loading = false
    Hub.GrapplerTP.Loaded = ok and type(_G.VanishStartSideTP) == "function"
    Hub.GrapplerTP.NeedsReload = not Hub.GrapplerTP.Loaded

    if not Hub.GrapplerTP.Loaded then
        ShowNotification("Grappler TP", tostring(err or "failed to load"))
    end
    return Hub.GrapplerTP.Loaded
end

local function invalidateGrapplerTP()
    Hub.GrapplerTP.Loaded = false
    Hub.GrapplerTP.NeedsReload = true
    if not Hub.GrapplerTP.Busy then
        _G.VanishStartSideTP = nil
        _G.VanishFireGrapple = nil
    end
end

local function runGrapplerTP()
    if Hub.isTpMoving or Hub.GrapplerTP.Busy then return end
    Hub.GrapplerTP.Busy = true

    local ok, err = pcall(function()
        Hub.GrapplerTP.ProxBefore = Hub.ProximityAPActive == true
        Hub.ProximityAPActive = false
        Hub.GrapplerTP.StartInBase = Hub.GetInBase and Hub.GetInBase() or false
        Hub.GrapplerTP.StartBaseOwner = Hub.GetBaseOwner and Hub.GetBaseOwner() or nil
        Hub.GrapplerTP.CloneBaseEntered = false
        Hub.GrapplerTP.CloneBaseOwner = nil
        Hub.GrapplerTP.TargetBaseOwner = nil
        Hub.GrapplerTP.TargetBasePlot = nil
        local selectedPetData = Hub.SelectedPetData
        local selectedData = selectedPetData and selectedPetData.animalData
        local selectedPart = selectedData and findAdorneeGlobal(selectedData)
        if selectedPart then
            Hub.GrapplerTP.TargetBaseOwner = selectedData.plot and getPlotOwner(selectedData.plot) or nil
            Hub.GrapplerTP.TargetBasePlot = selectedData.plot
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local entryPosition = nil
            if hrp then
                local exactPos = selectedPart.Position
                local plotIndex = getClosestBaseIdx(exactPos)
                local isFirstFloor = exactPos.Y <= 10
                local basePos = isFirstFloor and BASES_LOW[plotIndex] or BASES_HIGH[plotIndex]
                if basePos then
                    local closestZOffset = math.clamp(hrp.Position.Z - basePos.Z, -18, 18)
                    local frontPos = Vector3.new(basePos.X, isFirstFloor and 1 or basePos.Y, basePos.Z + closestZOffset)
                    local sidePos1 = isFirstFloor and SIDE_TP_LOW_1[plotIndex] or SIDE_TP_HIGH_1[plotIndex]
                    local sidePos2 = isFirstFloor and SIDE_TP_LOW_2[plotIndex] or SIDE_TP_HIGH_2[plotIndex]
                    local distToFront = (hrp.Position - frontPos).Magnitude
                    local distToSide1 = sidePos1 and (hrp.Position - sidePos1).Magnitude or math.huge
                    local distToSide2 = sidePos2 and (hrp.Position - sidePos2).Magnitude or math.huge
                    if distToFront <= distToSide1 and distToFront <= distToSide2 then
                        entryPosition = frontPos
                    elseif distToSide1 <= distToSide2 then
                        entryPosition = sidePos1
                    else
                        entryPosition = sidePos2
                    end
                end
            end
            _G.VanishPreferredPet = {
                name = selectedData.name,
                mutation = selectedData.mutation,
                position = selectedPart.Position,
                plot = selectedData.plot,
                slot = selectedData.slot,
                entryPosition = entryPosition,
            }
            Hub.GrapplerGoToPetData = {
                animalData = selectedData,
                targetPosition = selectedPart.Position,
                targetLookVector = selectedPart.CFrame.LookVector
            }
        else
            _G.VanishPreferredPet = nil
            Hub.GrapplerGoToPetData = nil
        end

        _G.VanishHubAfterCloneWait = function()
            local entered, owner = false, nil
            if Hub.WaitForCloneBaseEntry then
                entered, owner = Hub.WaitForCloneBaseEntry(Hub.GrapplerTP.StartInBase, Hub.GrapplerTP.StartBaseOwner, 3.5, Hub.GrapplerTP.TargetBaseOwner, Hub.GrapplerTP.TargetBasePlot)
            end
            Hub.GrapplerTP.CloneBaseEntered = entered == true
            Hub.GrapplerTP.CloneBaseOwner = owner
            if entered then
                RunService.Heartbeat:Wait()
            end
            return true
        end

        _G.VanishHubGoToSelectedBrainrot = function()
            local goData = Hub.GrapplerGoToPetData or Hub.SelectedPetData
            if not goData then return false end

            Hub.ProximityAPActive = false
            if not Hub.GrapplerTP.CloneBaseEntered and Hub.WaitForCloneBaseEntry then
                local entered, owner = Hub.WaitForCloneBaseEntry(Hub.GrapplerTP.StartInBase, Hub.GrapplerTP.StartBaseOwner, 4, Hub.GrapplerTP.TargetBaseOwner, Hub.GrapplerTP.TargetBasePlot)
                Hub.GrapplerTP.CloneBaseEntered = entered == true
                Hub.GrapplerTP.CloneBaseOwner = owner
            end
            if not Hub.GrapplerTP.CloneBaseEntered then
                Hub.GrapplerTP.Busy = false
                if Hub.GrapplerTP.ProxBefore ~= nil then
                    Hub.ProximityAPActive = Hub.GrapplerTP.ProxBefore == true
                    Hub.GrapplerTP.ProxBefore = nil
                end
                return false
            end

            Hub.PendingGoToBrainrotData = goData
            Hub.GrapplerGoToInProgress = true

            local function finishGrapplerGoTo()
                Hub.GrapplerGoToInProgress = false
                Hub.PendingGoToBrainrotData = nil
                Hub.GoToBrainrotMoveToken = nil
                if Hub.GrapplerTP.ProxBefore ~= nil then
                    Hub.ProximityAPActive = Hub.GrapplerTP.ProxBefore == true
                    Hub.GrapplerTP.ProxBefore = nil
                end
                Hub.GrapplerTP.Busy = false
            end

            if Hub.GoToSelectedBrainrotRetry then
                return Hub.GoToSelectedBrainrotRetry(10, goData, function()
                    finishGrapplerGoTo()
                end)
            elseif Hub.GoToSelectedBrainrot then
                task.spawn(function()
                    pcall(Hub.GoToSelectedBrainrot)
                    finishGrapplerGoTo()
                end)
                return true
            end

            finishGrapplerGoTo()
            return false
        end

        if _G.VanishClearGrapplerViz then pcall(_G.VanishClearGrapplerViz) end
        _G.VanishStartSideTP = nil
        Hub.GrapplerTP.Loaded = false
        if not ensureGrapplerTP() then return end
        _G.VanishStartSideTP()
        if not Hub.GrapplerGoToInProgress and Hub.GrapplerGoToPetData and (_G.TPStatus == "clone_ok" or (Hub.GetInBase and Hub.GetInBase())) then
            _G.VanishHubGoToSelectedBrainrot()
        end
        if not Hub.GrapplerGoToInProgress then
            Hub.ProximityAPActive = Hub.GrapplerTP.ProxBefore == true
            Hub.GrapplerTP.ProxBefore = nil
        end
    end)

    if Hub.GrapplerTP.ProxBefore ~= nil then
        if not Hub.GrapplerGoToInProgress then
            Hub.ProximityAPActive = Hub.GrapplerTP.ProxBefore == true
            Hub.GrapplerTP.ProxBefore = nil
        end
    end
    if not Hub.GrapplerGoToInProgress then
        Hub.GrapplerTP.Busy = false
    end
    if _G.VanishClearGrapplerViz then pcall(_G.VanishClearGrapplerViz) end
    if not ok then
        ShowNotification("Grappler TP", tostring(err))
    end
end
local function runTP()
    if (Config.TpSettings.Method or "Tween TP") == "Grappler TP" then
        runGrapplerTP()
        return
    end

    if Hub.isTpMoving then return end
    if tpResetCleanup then tpResetCleanup() end
    if Hub.carpetSpeedEnabled then setCarpetSpeed(false) end
    if not Hub.SelectedPetData then return end
    
    Hub.PATHFINDING_ACTIVE = true
    
    setNoAnimation(true)
    
    local targetPetData = Hub.SelectedPetData.animalData
    if not targetPetData then 
        setNoAnimation(false)
        Hub.PATHFINDING_ACTIVE = false
        return 
    end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then 
        setNoAnimation(false)
        Hub.PATHFINDING_ACTIVE = false
        return 
    end
    
    Hub.isTpMoving = true
    local Controls = getControls()
    Controls:Disable()
    
    local cleanup = function()
        pcall(function() Controls:Enable() end)
        Hub.isTpMoving = false
        Hub.PATHFINDING_ACTIVE = false
        if VisualFolder then
            for _, v in ipairs(VisualFolder:GetChildren()) do v:Destroy() end
        end
        TeleportBeam:Hide()
    end
    tpResetCleanup = cleanup
    
    local targetPart = findAdorneeGlobal(targetPetData)
    if not targetPart then 
        setNoAnimation(false)
        cleanup() 
        return 
    end
    
    local exactPos = targetPart.Position
    local teleportTarget = Pathfinding:GetTeleportTarget(targetPart)
    local isClear = teleportTarget and not Pathfinding:CheckCollision(hrp.Position, teleportTarget, char)
    
    local plotIndex = getClosestBaseIdx(exactPos)
    local isSecondFloor = exactPos.Y > 10
    local isThirdFloor = exactPos.Y > 25
    
    local finalFaceX = (plotIndex <= 4) and -1000 or 1000
    local finalFaceZ = nil
    local useXFace = true
    
    local playerZ = hrp.Position.Z
    local baseZ = (exactPos.Y <= 10) and BASES_LOW[plotIndex].Z or BASES_HIGH[plotIndex].Z
    local closestZOffset = math.clamp(playerZ - baseZ, -19, 19)
    
    local frontPos = Vector3.new(
        (exactPos.Y <= 10) and BASES_LOW[plotIndex].X or BASES_HIGH[plotIndex].X,
        (exactPos.Y <= 10) and 1 or BASES_HIGH[plotIndex].Y,
        baseZ + closestZOffset
    )
    
    local sidePos1 = nil
    local sidePos2 = nil
    
    if exactPos.Y <= 10 then
        sidePos1 = SIDE_TP_LOW_1[plotIndex]
        sidePos2 = SIDE_TP_LOW_2[plotIndex]
    else
        sidePos1 = SIDE_TP_HIGH_1[plotIndex]
        sidePos2 = SIDE_TP_HIGH_2[plotIndex]
    end
    
    local distToFront = (hrp.Position - frontPos).Magnitude
    local distToSide1 = sidePos1 and (hrp.Position - sidePos1).Magnitude or math.huge
    local distToSide2 = sidePos2 and (hrp.Position - sidePos2).Magnitude or math.huge
    
    if distToFront <= distToSide1 and distToFront <= distToSide2 then
        useXFace = true
    elseif distToSide1 <= distToSide2 then
        useXFace = false
        finalFaceZ = -500
    else
        useXFace = false
        finalFaceZ = 500
    end
    
    if useXFace then
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(finalFaceX, hrp.Position.Y, hrp.Position.Z))
    else
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(hrp.Position.X, hrp.Position.Y, finalFaceZ))
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait()
    
    if isClear then
        local carpet = LocalPlayer.Backpack:FindFirstChild(Config.TpSettings.Tool) or char:FindFirstChild(Config.TpSettings.Tool)
        if carpet then hum:EquipTool(carpet) end
        
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        local targetPosition = targetPart.Position
        
        if isSecondFloor or isThirdFloor then
            local underPos = Vector3.new(targetPosition.X, targetPosition.Y - 6.25, targetPosition.Z)
            
            local basePositions = {}
            if isThirdFloor then
                basePositions[1] = BASES_HIGH[plotIndex]
                basePositions[2] = SIDE_TP_HIGH_1[plotIndex]
                basePositions[3] = SIDE_TP_HIGH_2[plotIndex]
            else
                basePositions[1] = BASES_LOW[plotIndex]
                basePositions[2] = SIDE_TP_LOW_1[plotIndex]
                basePositions[3] = SIDE_TP_LOW_2[plotIndex]
            end
            
            local closestBasePos = nil
            local closestDist = math.huge
            for _, pos in pairs(basePositions) do
                if pos then
                    local dist = (hrp.Position - pos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestBasePos = pos
                    end
                end
            end
            
            local basePos = closestBasePos or (isThirdFloor and BASES_HIGH[plotIndex] or BASES_LOW[plotIndex])
            
            if useXFace then
                hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(finalFaceX, hrp.Position.Y, hrp.Position.Z))
            else
                hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(hrp.Position.X, hrp.Position.Y, finalFaceZ))
            end
            task.wait()
            
            followDynamicPath(hrp, underPos, MOVE_VELOCITY)
            
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(underPos, basePos)
            task.wait()
            
            createTempPlatform()
            
            local moved = false
            local floatMoveConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                local keys = {Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                    Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right}
                for _, k in ipairs(keys) do
                    if input.KeyCode == k then moved = true; break end
                end
                if input.UserInputType == Enum.UserInputType.Touch then moved = true end
                if moved then destroyTempPlatform() end
            end)
            
            local timeout = 0
            while not LocalPlayer:GetAttribute("Stealing") and not moved and timeout < 200 do
                if hrp.Position.Y > targetPart.Position.Y + 5 then
                    destroyTempPlatform()
                    local offsetPosition = targetPart.Position + (targetPart.CFrame.LookVector * 3.5)
                    hrp.CFrame = CFrame.new(offsetPosition, basePos)
                    break
                end
                timeout = timeout + 1
                task.wait(0.05)
            end
            
            destroyTempPlatform()
            if floatMoveConn then floatMoveConn:Disconnect() end
        else
            followDynamicPath(hrp, teleportTarget, MOVE_VELOCITY)
            hrp.CFrame = CFrame.new(teleportTarget)
        end
        
        setNoAnimation(false)
        cleanup()
        return
    end
    
    local isFirstFloor = exactPos.Y <= 10
    local plotIndex = getClosestBaseIdx(exactPos)
    
    local isPlotUnlocked = Hub.isTargetPlotUnlocked(targetPetData.plot)
    if Config.AutoUnlockOnSteal and not isPlotUnlocked then
        local plotObj = getPlot(targetPetData.plot)
        local plotModel = plotObj and plotObj.PlotModel
        if plotModel then
            open(plotModel)
            isPlotUnlocked = Hub.isTargetPlotUnlocked(targetPetData.plot)
        end
    end
    
    local carpet = LocalPlayer.Backpack:FindFirstChild(Config.TpSettings.Tool) or char:FindFirstChild(Config.TpSettings.Tool)
    if carpet then hum:EquipTool(carpet) end
    
    local baseZ = isFirstFloor and BASES_LOW[plotIndex].Z or BASES_HIGH[plotIndex].Z
    local baseY = isFirstFloor and 1 or BASES_HIGH[plotIndex].Y
    local baseX = isFirstFloor and BASES_LOW[plotIndex].X or BASES_HIGH[plotIndex].X
    
    local playerZ = hrp.Position.Z
    local closestZOffset = math.clamp(playerZ - baseZ, -18, 18)
    
    local isFrontPosition = false
    local targetBasePos = nil
    local faceDirection = nil
    
    local frontPos = Vector3.new(baseX, baseY, baseZ + closestZOffset)
    local distToFront = (hrp.Position - frontPos).Magnitude
    local distToSide1 = math.huge
    local distToSide2 = math.huge
    local sidePos1 = nil
    local sidePos2 = nil
    
    if isFirstFloor then
        sidePos1 = SIDE_TP_LOW_1[plotIndex]
        sidePos2 = SIDE_TP_LOW_2[plotIndex]
        if sidePos1 then distToSide1 = (hrp.Position - sidePos1).Magnitude end
        if sidePos2 then distToSide2 = (hrp.Position - sidePos2).Magnitude end
    else
        sidePos1 = SIDE_TP_HIGH_1[plotIndex]
        sidePos2 = SIDE_TP_HIGH_2[plotIndex]
        if sidePos1 then distToSide1 = (hrp.Position - sidePos1).Magnitude end
        if sidePos2 then distToSide2 = (hrp.Position - sidePos2).Magnitude end
    end
    
    if distToFront <= distToSide1 and distToFront <= distToSide2 then
        targetBasePos = frontPos
        isFrontPosition = true
        local faceX = (plotIndex <= 4) and -1000 or 1000
        faceDirection = Vector3.new(faceX, hrp.Position.Y, hrp.Position.Z)
    elseif distToSide1 <= distToSide2 then
        targetBasePos = sidePos1
        isFrontPosition = false
        faceDirection = Vector3.new(hrp.Position.X, hrp.Position.Y, -500)
    else
        targetBasePos = sidePos2
        isFrontPosition = false
        faceDirection = Vector3.new(hrp.Position.X, hrp.Position.Y, 500)
    end
    
    if not targetBasePos then 
        targetBasePos = frontPos
        isFrontPosition = true
        local faceX = (plotIndex <= 4) and -1000 or 1000
        faceDirection = Vector3.new(faceX, hrp.Position.Y, hrp.Position.Z)
    end
    
    hrp.CFrame = CFrame.lookAt(hrp.Position, faceDirection)
    task.wait()
    
    followDynamicPath(hrp, targetBasePos, MOVE_VELOCITY)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.lookAt(hrp.Position, faceDirection)
    hrp.AssemblyLinearVelocity = Vector3.zero
    setNoAnimation(false)
    hrp.AssemblyLinearVelocity = Vector3.zero
    
    local skipCloneSequence = isFrontPosition and isPlotUnlocked
    
    if not skipCloneSequence then
        hrp.AssemblyLinearVelocity = Vector3.zero
        
        local usingLowBase = (exactPos.Y <= 10)
        
        if usingLowBase then
            hrp.AssemblyLinearVelocity = Vector3.zero
            createStillPlatform()
            hrp.AssemblyLinearVelocity = Vector3.zero
            walk(0.29)
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.3)
            hrp.AssemblyLinearVelocity = Vector3.zero
        else
            createStillPlatform()
            hrp.AssemblyLinearVelocity = Vector3.zero
            walk(0.19)
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.2)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        
        Hub.cloneFailed = false
        Clone()
        while Hub.isCloning do task.wait() end
        
        if Hub.cloneFailed then
            Hub.cloneFailed = false
            setNoAnimation(false)
            cleanup()
            return
        end
        
        destroyStillPlatform()
        hum:EquipTool(carpet)
        task.wait(Config.TpSettings.PostCloneDelay or 0)

        targetPart = findAdorneeGlobal(targetPetData)
        if not targetPart then
            setNoAnimation(false)
            cleanup()
            return
        end
        exactPos = targetPart.Position
        plotIndex = getClosestBaseIdx(exactPos)
        isSecondFloor = exactPos.Y > 10
        isThirdFloor = exactPos.Y > 25
    end
    
    local basePosFace = BASES_FACE[plotIndex]
    local offsetPosition = targetPart.Position + (targetPart.CFrame.LookVector * 3.5)
    local finalPos = offsetPosition
    
    if isThirdFloor then
        finalPos = Vector3.new(exactPos.X, exactPos.Y - 6.25, exactPos.Z) + (targetPart.CFrame.LookVector * 3.5)
    end
    
    local direction = (finalPos - hrp.Position).Unit
    local distance = (finalPos - hrp.Position).Magnitude
    local totalTime = distance / FINAL_VELOCITY
    local startTime = tick()
    local startPos = hrp.Position

    while tick() - startTime < totalTime do
        local t = (tick() - startTime) / totalTime
        local newPos = startPos + direction * (distance * t)
        hrp.CFrame = CFrame.new(newPos)
        hrp.AssemblyLinearVelocity = direction * FINAL_VELOCITY
        task.wait()
    end

    hrp.CFrame = CFrame.new(finalPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(finalPos, basePosFace)
    
    if isSecondFloor or isThirdFloor then
        createTempPlatform()
        local moved = false
        local conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.Touch then
                moved = true
                destroyTempPlatform()
            end
        end)
        
        local timeout = 0
        while not LocalPlayer:GetAttribute("Stealing") and not moved and timeout < 200 do
            if hrp.Position.Y > targetPart.Position.Y + 5 then
                destroyTempPlatform()
                hrp.CFrame = CFrame.new(finalPos, basePosFace)
                break
            end
            timeout = timeout + 1
            task.wait(0.05)
        end
        destroyTempPlatform()
        if conn then conn:Disconnect() end
    end
    
    setNoAnimation(false)
    cleanup()
end

