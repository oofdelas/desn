            task.wait(0.05)
            animationTrickery()
            task.defer(function()
                if Hub.resetBrainrotBeam then pcall(Hub.resetBrainrotBeam) end
                if Hub.resetPlotBeam then pcall(Hub.resetPlotBeam) end
                task.wait(0.1)
                if Hub.updateBrainrotBeam then pcall(Hub.updateBrainrotBeam) end
                if Hub.createPlotBeam then pcall(Hub.createPlotBeam) end
            end)
            local lastSetPosition = nil
            local skipFrames = 5
            connection = RunService.PreSimulation:Connect(function()
                if character and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 and oldRoot then
                    local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
                    if root then
                        if skipFrames > 0 then
                            skipFrames = skipFrames - 1
                            lastSetPosition = nil
                        elseif lastSetPosition and ghostEnabled then
                            local currentPos = oldRoot.Position
                            local jumpDist = (currentPos - lastSetPosition).Magnitude
                            if jumpDist > 3 and not Hub.RecoveryInProgress then
                                lastSetPosition = nil
                                createServerGhost(currentPos)
                                if Hub.AutoRecoverLagback and Hub.toggleInvisibleSteal then
                                    Hub.RecoveryInProgress = true
                                    task.spawn(function()
                                        pcall(Hub.toggleInvisibleSteal); task.wait(0.5)
                                        pcall(Hub.toggleInvisibleSteal); Hub.RecoveryInProgress = false
                                    end)
                                end
                            end
                        end
                        if clone then clone.CanCollide = false end
                        for _, c in pairs(oldRoot:GetChildren()) do
                            if c:IsA("Attachment") or c:IsA("Beam") then c:Destroy() end
                        end
                        local rotAngle = Hub.InvisStealAngle or 180
                        local sa = (Hub.SinkSliderValue or 5) * 0.5
                        local cf = root.CFrame - Vector3.new(0, sa, 0)
                        oldRoot.CFrame = cf * CFrame.Angles(math.rad(rotAngle), 0, 0)
                        oldRoot.AssemblyLinearVelocity = root.AssemblyLinearVelocity
                        oldRoot.CanCollide = false
                        lastSetPosition = oldRoot.Position
                    end
                end
            end)
        end
    end

    local function handleAutoInvisOnSteal()
        local wasStealingForInvis = false
        local invisWasEnabledBefore = false
        local autoEnabledInvis = false
        
        task.wait(1)
        while task.wait(0.1) do
            if Hub.AutoInvisDuringSteal == false then
                wasStealingForInvis = false
                autoEnabledInvis = false
            else
                local isStealing = LocalPlayer:GetAttribute("Stealing")
                if isStealing and not wasStealingForInvis then
                    invisWasEnabledBefore = Hub.invisibleStealEnabled or false
                    if not Hub.invisibleStealEnabled and Hub.toggleInvisibleSteal then
                        task.delay(0.25, function()
                            if LocalPlayer:GetAttribute("Stealing") and not Hub.invisibleStealEnabled then
                                pcall(Hub.toggleInvisibleSteal)
                                autoEnabledInvis = true
                            end
                        end)
                    end
                end
                if not isStealing and autoEnabledInvis and Hub.invisibleStealEnabled and Hub.toggleInvisibleSteal then
                    pcall(Hub.toggleInvisibleSteal)
                    autoEnabledInvis = false
                end
                wasStealingForInvis = isStealing
            end
        end
    end
    
