do
    local D = Hub.Desync
    D.jumpTimer = D.jumpTimer or {0}
    D.snapTimer = D.snapTimer or {0}
    D.doubleTimer = D.doubleTimer or {0}
    D.stealTimer = D.stealTimer or {0}
    D.watchedFolders = D.watchedFolders or {}
    D.lastPacketSend = D.lastPacketSend or os.clock()
    D.lastHrpPos = nil
    D.lastVel = D.lastVel or Vector3.new(0, 0, 0)
    D.skipFrames = D.skipFrames or 0
    D.stealPending = false
    D.prevStealing = false
    D.prevStealIdx = ""

    local function desyncMethod()
        return Config.DesyncMethod == "On Load" and "On Load" or "On Steal"
    end

    local function desyncActive()
        return Config.DesyncEnabled == true
    end

    local function desyncAllowedForMethod()
        if not desyncActive() then return false end
        if desyncMethod() == "On Load" then return true end
        return LocalPlayer:GetAttribute("Stealing") == true
    end

    local function getRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function debounce(timer, delay)
        local now = os.clock()
        if now - timer[1] < (delay or 0.4) then return false end
        timer[1] = now
        return true
    end

    local function takeSnapshot()
        local root = getRoot()
        if root then
            D.snapshotCFrame = root.CFrame
        end
    end

    local function onLagback(method)
        if not desyncAllowedForMethod() then return end
        D.lastLagbackMethod = method
        D.lastLagbackTime = os.clock()
        takeSnapshot()
        task.delay(0.15, takeSnapshot)
    end

    local function watchFolder(folder)
        if not folder or D.watchedFolders[folder] then return end
        D.watchedFolders[folder] = true
        folder.ChildAdded:Connect(function(child)
            if child.Name ~= "DoubleRig" then return end
            task.defer(function()
                task.wait(0.05)
                local rr = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart")
                if rr and getRoot() and debounce(D.doubleTimer, 0.1) then
                    onLagback("DoubleRig")
                end
            end)
        end)
    end

    local function hookFolder()
        local folder = workspace:FindFirstChild(LocalPlayer.Name)
        if folder then
            watchFolder(folder)
        elseif not D.waitingForFolder then
            D.waitingForFolder = true
            workspace.ChildAdded:Connect(function(child)
                if child.Name == LocalPlayer.Name then
                    watchFolder(child)
                end
            end)
        end
    end

    local function onStealDetected(reason)
        if D.stealPending then return end
        D.stealPending = true
        task.delay(0.25, function()
            if debounce(D.stealTimer) then
                onLagback("Steal:" .. tostring(reason))
            end
            D.stealPending = false
        end)
    end

    function Hub.RefreshDesync()
        Config.DesyncMethod = desyncMethod()
        D.enabled = desyncActive()
        D.method = Config.DesyncMethod
        if D.enabled then
            takeSnapshot()
        end
    end

    if not D.installed then
        D.installed = true
        hookFolder()

        LocalPlayer.CharacterAdded:Connect(function()
            D.lastHrpPos = nil
            D.lastVel = Vector3.new(0, 0, 0)
            D.skipFrames = 12
            task.wait(0.5)
            hookFolder()
            if desyncActive() then
                takeSnapshot()
            end
        end)

        RunService.Heartbeat:Connect(function(dt)
            if not desyncActive() then return end
            if D.skipFrames > 0 then
                D.skipFrames -= 1
                return
            end

            local hrp = getRoot()
            if not hrp then
                D.lastHrpPos = nil
                return
            end

            local cur = hrp.Position
            if D.lastHrpPos then
                local delta = cur - D.lastHrpPos
                local mag = delta.Magnitude
                if mag > 5 and debounce(D.jumpTimer) then
                    onLagback("HRP-Jump " .. string.format("%.1f", mag) .. "st")
                end
                if mag > 3 and mag <= 5 and D.lastVel.Magnitude > 0.1 then
                    local dot = delta.Unit:Dot(D.lastVel.Unit)
                    if dot < -0.5 and debounce(D.snapTimer) then
                        onLagback("Snap " .. string.format("%.1f", mag) .. "st")
                    end
                end
                D.lastVel = D.lastVel:Lerp(delta / math.max(dt, 0.001), 0.4)
            end
            D.lastHrpPos = cur
        end)

        LocalPlayer:GetAttributeChangedSignal("StealingIndex"):Connect(function()
            local value = LocalPlayer:GetAttribute("StealingIndex")
            if type(value) == "string" and value ~= "" then
                onStealDetected("idx=" .. value)
            end
        end)

        LocalPlayer:GetAttributeChangedSignal("Stealing"):Connect(function()
            if LocalPlayer:GetAttribute("Stealing") == true then
                task.delay(0.3, function()
                    if not D.stealPending then onStealDetected("backup") end
                end)
            else
                D.stealPending = false
            end
        end)

        RunService.Heartbeat:Connect(function()
            local stealing = LocalPlayer:GetAttribute("Stealing") == true
            local idx = tostring(LocalPlayer:GetAttribute("StealingIndex") or "")
            if stealing and not D.prevStealing and not D.stealPending then
                onStealDetected("poll")
            end
            if idx ~= "" and D.prevStealIdx == "" and not D.stealPending then
                onStealDetected("idx_poll=" .. idx)
            end
            D.prevStealing = stealing
            D.prevStealIdx = idx
        end)

        if raknet and raknet.add_send_hook and buffer and buffer.writeu32 then
            raknet.add_send_hook(function(packet)
                if not packet or not desyncAllowedForMethod() or packet.PacketId ~= 0x1B then return end
                if os.clock() - D.lastPacketSend >= 6 then
                    D.lastPacketSend = os.clock()
                    task.defer(takeSnapshot)
                    return
                end
                local ok = pcall(function()
                    local data = packet.AsBuffer
                    buffer.writeu32(data, 1, 0/0)
                    packet:SetData(data)
                end)
                if not ok then
                    D.lastPacketSend = os.clock()
                end
            end)
        end
    end

    Hub.RefreshDesync()
end

