local function findClosest(petPos, coordTable, fromPos, entryPos)
    local origin = fromPos or petPos
    if typeof(entryPos) == "Vector3" then
        local best, bestKey, bestDist = nil, nil, math.huge
        for skyKey, coords in pairs(coordTable) do
            for _, data in ipairs(coords) do
                local c = data.coord
                local d = math.sqrt((entryPos.X - c.X)^2 + (entryPos.Z - c.Z)^2)
                if d < bestDist then
                    bestDist = d
                    best = data
                    bestKey = skyKey
                end
            end
        end
        if best then return best, bestKey end
    end

    local targetKey, targetDist = nil, math.huge
    for skyKey, coords in pairs(coordTable) do
        for _, data in ipairs(coords) do
            local c = data.coord
            local d = math.sqrt((petPos.X - c.X)^2 + (petPos.Z - c.Z)^2)
            if d < targetDist then
                targetDist = d
                targetKey = skyKey
            end
        end
    end

    local best, bestDist = nil, math.huge
    for _, data in ipairs(coordTable[targetKey] or {}) do
        local c = data.coord
        local d = math.sqrt((origin.X - c.X)^2 + (origin.Z - c.Z)^2)
        if d < bestDist then
            bestDist = d
            best = data
        end
    end
    return best, targetKey
end

