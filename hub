        if input.KeyCode == (Hub.INVISIBLE_STEAL_KEY or Enum.KeyCode.I) then
            pcall(Hub.toggleInvisibleSteal)
            if updateVisualState then updateVisualState(Hub.invisibleStealEnabled or false) end
        end
    end)

    local function onCharacterAdded(newChar)
        clearErrorOrb()
        clearAllGhosts()
        lagbackCallCount = 0
        pcall(function()
            for _, c in pairs(Workspace.CurrentCamera:GetChildren()) do
                if c:IsA("BasePart") and c.Name == "HumanoidRootPart" then c:Destroy() end
            end
        end)
        if oldRoot then pcall(function() oldRoot:Destroy() end); oldRoot = nil end
        if clone then pcall(function() clone:Destroy() end); clone = nil end
        animPlaying = false
        Hub.invisibleStealEnabled = false
        if Hub.updateMovementPanelInvisVisual then pcall(Hub.updateMovementPanelInvisVisual, false) end
        task.wait(0.2)
        local camera = Workspace.CurrentCamera
        if camera and newChar then
            local h = newChar:FindFirstChildOfClass("Humanoid")
