            lighting.Ambient = ambientColor
            lighting.OutdoorAmbient = ambientColor
            
            lighting.FogEnd = 9e9
            lighting.FogStart = 0
        end
        
        local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
        if atmosphere then atmosphere:Destroy() end
    end)
end

