local inBase = false
local lastOwner = nil
local plotBoundsCache = {}

local function rebuildPlotBoundsCache()
    local newCache = {}
    for uid, plot in PlotController:GetPlots() do
        local podiums = plot.PlotModel:FindFirstChild("AnimalPodiums")
        if podiums then
            local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
            local cnt = 0
            for _, p in ipairs(podiums:GetChildren()) do
                local base = p:FindFirstChild("Base")
                local spawn = base and base:FindFirstChild("Spawn")
                local checkPos = spawn and spawn.Position or (base and base.Position)
                if checkPos then
                    cnt += 1
                    if checkPos.X < minX then minX = checkPos.X end
                    if checkPos.X > maxX then maxX = checkPos.X end
                    if checkPos.Z < minZ then minZ = checkPos.Z end
                    if checkPos.Z > maxZ then maxZ = checkPos.Z end
                end
            end
            if cnt > 0 then
                newCache[uid] = {
                    cx   = (minX + maxX) / 2,
                    cz   = (minZ + maxZ) / 2,
                    sx   = (maxX - minX) + 13,
                    sz   = (maxZ - minZ) + 8,
                    maxY = cnt <= 10 and 10 or cnt <= 18 and 25 or 40,
                }
            end
        end
    end
    plotBoundsCache = newCache
end

rebuildPlotBoundsCache()
local boundsTimer = 0
RunService.RenderStepped:Connect(function(dt)
    boundsTimer += dt
    if boundsTimer >= 30 then
        boundsTimer = 0
        rebuildPlotBoundsCache()
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local pos = hrp.Position
    local newInBase, newOwner = false, nil

    for uid, bounds in plotBoundsCache do
        if pos.Y <= bounds.maxY and pos.Y >= -10
           and math.abs(pos.X - bounds.cx) <= bounds.sx / 2
           and math.abs(pos.Z - bounds.cz) <= bounds.sz / 2 then
            local ownerName = getPlotOwner(uid)
            if ownerName then
                newInBase = true
                newOwner = ownerName
                break
            end
        end
    end

    if newInBase and not inBase and newOwner then
        ShowNotification("Base Entry", newOwner .. "'s Base")
    elseif not newInBase and inBase and lastOwner then
        ShowNotification("Left Base", "Exited " .. lastOwner .. "'s Base")
    elseif newInBase and inBase and newOwner and newOwner ~= lastOwner then
        ShowNotification("Base Entry", newOwner .. "'s Base")
    end

    inBase = newInBase
    lastOwner = newOwner
end)

Hub.GetInBase = function() return inBase end
Hub.GetBaseOwner = function() return lastOwner end
Hub.GetBaseOwnerAtPosition = function(pos)
    if typeof(pos) ~= "Vector3" then return nil end
    for uid, bounds in plotBoundsCache do
        if pos.Y <= bounds.maxY and pos.Y >= -10
           and math.abs(pos.X - bounds.cx) <= bounds.sx / 2
           and math.abs(pos.Z - bounds.cz) <= bounds.sz / 2 then
            return getPlotOwner(uid), uid
        end
    end
    return nil
end

Hub.WaitForCloneBaseEntry = function(startInBase, startBaseOwner, timeout, expectedOwner, expectedPlot)
    local started = tick()
    repeat
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local owner, plotUid = nil, nil
            if Hub.GetBaseOwnerAtPosition then
                owner, plotUid = Hub.GetBaseOwnerAtPosition(hrp.Position)
            end
            owner = owner or (Hub.GetBaseOwner and Hub.GetBaseOwner())
            local plotMatches = (not expectedPlot) or (plotUid and tostring(plotUid) == tostring(expectedPlot))
            if owner and plotMatches and (not expectedOwner or owner == expectedOwner) and (not startInBase or owner ~= startBaseOwner) then
                return true, owner
            end
        end
        RunService.Heartbeat:Wait()
    until tick() - started > (timeout or 3)
    return false, nil
end

local function Clone(goToBrainrotAfterBase)
    if Hub.isCloning then return end
    Hub.isCloning = true
    Hub.cloneFailed = false

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Hub.isCloning = false
        return
    end

    local startInBase = Hub.GetInBase and Hub.GetInBase() or false
    local startBaseOwner = Hub.GetBaseOwner and Hub.GetBaseOwner() or nil

    local moveCancelled = false
    local moveConn
    moveConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        local movementKeys = {
            Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
            Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right
        }
        for _, key in ipairs(movementKeys) do
            if input.KeyCode == key then
                moveCancelled = true
                return
            end
        end
        if input.UserInputType == Enum.UserInputType.Touch then
            moveCancelled = true
        end
    end)

    local cloneError = false
    local cloner = nil
    local hum = nil

    char = LocalPlayer.Character
    if not char then
        cloneError = true
    else
        hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then
            cloneError = true
        else
            cloner = LocalPlayer.Backpack:FindFirstChild("Quantum Cloner") or char:FindFirstChild("Quantum Cloner")
            if not cloner then
                cloneError = true
            end
        end
    end

    if not cloneError then
        if cloner.Parent ~= char then
            local equipOk = pcall(function()
                hum:EquipTool(cloner)
                task.wait()
            end)
            if not equipOk then
                cloneError = true
            end
        end
    end

    if not cloneError then
        local activateOk = pcall(function()
            cloner:Activate()
        end)
        if not activateOk then
            cloneError = true
        end
    end

    if not cloneError then
        task.wait(0.05)
        
        local toolsFrames = LocalPlayer.PlayerGui:FindFirstChild("ToolsFrames")
        local qcFrame = toolsFrames and toolsFrames:FindFirstChild("QuantumCloner")
        local tpButton = qcFrame and qcFrame:FindFirstChild("TeleportToClone")
        
        if not tpButton then
            cloneError = true
        else
            tpButton.Visible = true
            local clickOk = pcall(function()
                if firesignal then
                    firesignal(tpButton.MouseButton1Up)
                    if Hub.triggerSafePollBoost then
                        Hub.triggerSafePollBoost()
                    end
                end
            end)
            if not clickOk then
                cloneError = true
            end
        end
    end

    if moveConn then
        moveConn:Disconnect()
    end

    if moveCancelled then
        Hub.isCloning = false
        Hub.cloneFailed = false
        return
    end

    if cloneError then
        Hub.isCloning = false
        Hub.cloneFailed = true
        return
    end

    local startTime = tick()
    local baseEntered = false
    local enteredBase = nil
    local heartbeatConn = nil

    heartbeatConn = RunService.Heartbeat:Connect(function()
        if (tick() - startTime) >= 1.5 then
            if heartbeatConn then heartbeatConn:Disconnect() end
            return
        end
        local currentInBase = Hub.GetInBase and Hub.GetInBase() or false
        local currentOwner = Hub.GetBaseOwner and Hub.GetBaseOwner() or nil
        if currentInBase then
            if not startInBase or (startInBase and currentOwner ~= startBaseOwner) then
                baseEntered = true
                enteredBase = currentOwner
                if heartbeatConn then heartbeatConn:Disconnect() end
            end
        end
    end)

    while not baseEntered and (tick() - startTime) < 1.5 do
        task.wait()
    end
    if heartbeatConn then heartbeatConn:Disconnect() end

    if baseEntered then
        Hub.isCloning = false
        Hub.cloneFailed = false
        if goToBrainrotAfterBase and Hub.GoToSelectedBrainrot then
            if Hub.GoToSelectedBrainrotRetry then
                Hub.GoToSelectedBrainrotRetry(10)
            else
                task.spawn(Hub.GoToSelectedBrainrot)
            end
        end
    elseif not cloneError then
        Hub.isCloning = false
        Hub.cloneFailed = false
    else
        Hub.cloneFailed = true
        Hub.isCloning = false
    end
end

