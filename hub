        end
        local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        local fc = (lastFps >= 50) and "rgb(70,255,150)" or (lastFps >= 30) and "rgb(255,210,70)" or "rgb(255,90,110)"
