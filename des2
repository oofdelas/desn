local fileName = "AlbuxDesyncConfig.json"

local function savePos(pos)
    if writefile then
        writefile(fileName, HttpService:JSONEncode({
            X_Scale = pos.X.Scale, X_Offset = pos.X.Offset,
            Y_Scale = pos.Y.Scale, Y_Offset = pos.Y.Offset,
        }))
    end
end

local function loadPos()
    if isfile and readfile and isfile(fileName) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if ok and data and data.X_Scale then
            return UDim2.new(data.X_Scale, data.X_Offset, data.Y_Scale, data.Y_Offset)
        end
    end
    return UDim2.new(0.1, 0, 0.4, 0)
end

