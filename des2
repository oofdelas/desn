local function onLagback(method)
    if not desyncEnabled or not orb or orb.Parent ~= workspace then return end
    if not (LocalPlayer:GetAttribute("Stealing") == true) then return end
    lastLagbackMethod = method
    lastLagbackTime   = os.clock()
