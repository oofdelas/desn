end

-- // DETECTION 1: DoubleRig
local function watchFolder(folder)
    folder.ChildAdded:Connect(function(child)
        if child.Name ~= "DoubleRig" then return end
        task.defer(function()
            task.wait(0.05)
            local rr  = child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart")
            local hrp = getRoot()
            if rr and hrp and debounce(dDouble, 0.1) then
                onLagback("DoubleRig")
            end
        end)
    end)
end

local function hookFolder()
    local f = workspace:FindFirstChild(LocalPlayer.Name)
    if f then
        watchFolder(f)
    else
        workspace.ChildAdded:Connect(function(c)
            if c.Name == LocalPlayer.Name then watchFolder(c) end
        end)
    end
end
