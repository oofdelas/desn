-- // DETECTION 2 & 3: HRP jump / snap
RunService.Heartbeat:Connect(function(dt)
    if not desyncEnabled then return end
    if skipFrames > 0 then skipFrames -= 1; return end

    local hrp = getRoot()
    if not hrp then lastHRPPos = nil; return end

    local cur = hrp.Position

    if lastHRPPos then
        local delta = cur - lastHRPPos
        local mag   = delta.Magnitude

        if mag > BIG_JUMP and debounce(dJump) then
            onLagback("HRP-Jump " .. string.format("%.1f", mag) .. "st")
        end

        if mag > SMALL_SNAP and mag <= BIG_JUMP then
            if lastVel.Magnitude > 0.1 then
                local dot = delta.Unit:Dot(lastVel.Unit)
                if dot < REVERSAL_CUTOFF and debounce(dSnap) then
                    onLagback("Snap " .. string.format("%.1f", mag) .. "st")
                end
            end
        end

        lastVel = lastVel:Lerp(delta / math.max(dt, 0.001), 0.4)
    end

    lastHRPPos = cur
end)

